# Copie este arquivo para .env apenas no ambiente local.
# Nunca envie .env para o GitHub.

JWT_SECRET=troque-por-uma-chave-local-longa
TOKEN_EXP_HOURS=8
GEMINI_API_KEY=cole-a-chave-do-gemini-aqui
GEMINI_MODEL=gemini-3.8-flash

# Os caminhos abaixo são opcionais. Por padrão a aplicação usa data/users.db e data/equilibra.db.
# AUTH_DB_PATH=data/users.db
# APP_DB_PATH=data/equilibra.db

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
