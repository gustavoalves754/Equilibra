# Copie para .env apenas no ambiente local.
# Nunca envie o arquivo .env ao GitHub.

JWT_SECRET=troque-por-uma-chave-local-com-pelo-menos-32-caracteres
TOKEN_EXP_HOURS=8

# Gemini: informe a chave apenas no arquivo .env local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# O projeto usa dois bancos separados.
# Por padrão, os arquivos ficam dentro de data/.
# AUTH_DB_PATH=data/users.db
